<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rinko.scheduler.repository.SchedulerExecutionMapper">
    <resultMap id="execMap" type="com.rinko.scheduler.entity.SchedulerExecution">
        <id property="id" column="id"/>
        <result property="jobId" column="job_id"/>
        <result property="status" column="status"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="retryCount" column="retry_count"/>
        <result property="result" column="result"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>
    <insert id="insert">INSERT INTO scheduler_executions (id,job_id,status,start_time,retry_count,created_at) VALUES (#{id},#{jobId},#{status},NOW(),#{retryCount},NOW())</insert>
    <update id="update">UPDATE scheduler_executions SET status=#{status},end_time=NOW(),retry_count=#{retryCount},result=#{result} WHERE id=#{id}</update>
    <select id="findByJobId" resultMap="execMap">SELECT * FROM scheduler_executions WHERE job_id=#{jobId} ORDER BY start_time DESC</select>
</mapper>
