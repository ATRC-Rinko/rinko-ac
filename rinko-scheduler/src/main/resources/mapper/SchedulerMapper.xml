<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rinko.scheduler.repository.SchedulerJobMapper">
    <resultMap id="jobMap" type="com.rinko.scheduler.entity.SchedulerJob">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="type" column="type"/>
        <result property="cronExpression" column="cron_expression"/>
        <result property="config" column="config"/>
        <result property="enabled" column="enabled"/>
        <result property="maxRetries" column="max_retries"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>
    <insert id="insert">INSERT INTO scheduler_jobs (id,name,type,cron_expression,config,enabled,max_retries,created_at,updated_at) VALUES (#{id},#{name},#{type},#{cronExpression},#{config},#{enabled},#{maxRetries},NOW(),NOW())</insert>
    <update id="update">UPDATE scheduler_jobs SET name=#{name},type=#{type},cron_expression=#{cronExpression},config=#{config},enabled=#{enabled},max_retries=#{maxRetries},updated_at=NOW() WHERE id=#{id}</update>
    <delete id="deleteById">DELETE FROM scheduler_jobs WHERE id=#{id}</delete>
    <select id="findAll" resultMap="jobMap">SELECT * FROM scheduler_jobs ORDER BY name</select>
    <select id="findById" resultMap="jobMap">SELECT * FROM scheduler_jobs WHERE id=#{id}</select>
    <select id="findByName" resultMap="jobMap">SELECT * FROM scheduler_jobs WHERE name=#{name}</select>
</mapper>
