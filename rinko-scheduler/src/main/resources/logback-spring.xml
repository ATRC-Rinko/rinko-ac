<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <!--        <encoder class="com.rinko.infra.log.JsonEncoder">-->
        <!--            <serviceName>rinko-auth</serviceName>-->
        <!--        </encoder>-->
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/rinko-scheduler.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/rinko-scheduler.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder class="com.rinko.infra.log.JsonEncoder">
            <serviceName>rinko-scheduler</serviceName>
        </encoder>
    </appender>
    <appender name="KAFKA" class="com.rinko.infra.log.KafkaLogAppender">
        <topic>rinko-logs</topic>
        <serviceName>rinko-scheduler</serviceName>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="KAFKA"/>
    </root>
</configuration>
