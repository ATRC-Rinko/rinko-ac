<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rinko.notify.repository.NotificationTemplateMapper">

    <resultMap id="templateMap" type="com.rinko.notify.entity.NotificationTemplate">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="subject" column="subject"/>
        <result property="body" column="body"/>
        <result property="channels" column="channels"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.rinko.notify.entity.NotificationTemplate">
        INSERT INTO notification_templates (id, code, name, subject, body, channels, created_at, updated_at)
        VALUES (#{id}, #{code}, #{name}, #{subject}, #{body}, #{channels}, NOW(), NOW())
    </insert>

    <update id="update" parameterType="com.rinko.notify.entity.NotificationTemplate">
        UPDATE notification_templates SET name = #{name}, subject = #{subject}, body = #{body},
            channels = #{channels}, updated_at = NOW() WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM notification_templates WHERE id = #{id}
    </delete>

    <select id="findAll" resultMap="templateMap">
        SELECT * FROM notification_templates ORDER BY code
    </select>

    <select id="findByCode" resultMap="templateMap">
        SELECT * FROM notification_templates WHERE code = #{code}
    </select>

    <select id="findById" resultMap="templateMap">
        SELECT * FROM notification_templates WHERE id = #{id}
    </select>

</mapper>
