<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rinko.oss.repository.FileVersionRepository">

    <resultMap id="fileVersionMap" type="com.rinko.oss.entity.FileVersion">
        <id property="id" column="id"/>
        <result property="fileId" column="file_id"/>
        <result property="version" column="version"/>
        <result property="fileSize" column="file_size"/>
        <result property="sha256" column="sha256"/>
        <result property="storagePath" column="storage_path"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.rinko.oss.entity.FileVersion">
        INSERT INTO file_versions (id, file_id, version, file_size, sha256, storage_path, created_at)
        VALUES (#{id}, #{fileId}, #{version}, #{fileSize}, #{sha256}, #{storagePath}, NOW())
    </insert>

    <select id="findByFileIdOrderByVersionDesc" resultMap="fileVersionMap">
        SELECT * FROM file_versions WHERE file_id = #{fileId} ORDER BY version DESC
    </select>

    <select id="findByFileIdAndVersion" resultMap="fileVersionMap">
        SELECT * FROM file_versions WHERE file_id = #{fileId} AND version = #{version}
    </select>

    <select id="getMaxVersion" resultType="int">
        SELECT COALESCE(MAX(version), 0) FROM file_versions WHERE file_id = #{fileId}
    </select>

</mapper>
